{
  "name": "obsidian-tasks-engine-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "MCP server that runs the real Obsidian Tasks query engine outside of Obsidian",
  "license": "MIT",
  "author": "Christoph Zwerschke",
  "homepage": "https://github.com/Cito/obsidian-tasks-engine-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cito/obsidian-tasks-engine-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/Cito/obsidian-tasks-engine-mcp/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "obsidian",
    "obsidian-tasks"
  ],
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "node scripts/typecheck.mjs",
    "lint": "eslint . --max-warnings 0",
    "cli": "npm run build && node dist/cli.js",
    "serve": "npm run build && node dist/server.js",
    "test": "npm run typecheck && npm run lint && npm run build && node dist/selftest.js && node dist/conformance.js && node scripts/mcp-smoke.mjs && node scripts/mcp-smoke.mjs --http",
    "conformance": "npm run build && node dist/conformance.js",
    "check": "npm run build && node dist/cli.js --check"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.7.6",
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "async-mutex": "^0.5.0",
    "boon-js": "^2.0.5",
    "chrono-node": "2.3.9",
    "eventemitter2": "^6.4.5",
    "flatpickr": "^4.6.13",
    "i18next": "^26.4.2",
    "moment": "^2.30.1",
    "mustache": "^4.2.0",
    "mustache-validator": "^0.2.0",
    "rrule": "^2.8.1",
    "safe-regex2": "^5.1.1",
    "yaml": "^2.9.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.2",
    "esbuild": "^0.25.0",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.70.0"
  }
}
